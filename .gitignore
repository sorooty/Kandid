# deps
node_modules/
.pnpm-store/
.venv/

# build and caches
dist/
build/
*.tsbuildinfo
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
coverage/
.coverage
playwright-report/
test-results/

# v1 leftovers that may still sit in a local checkout (code lives on the legacy branch)
/apps/
/packages/
/supabase/
.turbo/

# env (never commit real secrets)
.env
.env.*
!.env.example
*.pem

# user data: never in the repository, whatever the folder is called
/import/
/data/
.kandid/
/applications/
profile.yaml
config.yaml
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.csv
*.pdf
*.docx
logs/
# fictional fixtures and templates are the only documents allowed in Git
!examples/**
!templates/**
!tests/fixtures/**

# claude local
.claude/settings.local.json

# os / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.log
